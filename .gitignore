# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# admin által feltöltött képek (helyi demó-adat)
/public/uploads/*
!/public/uploads/.gitkeep
/data/site.json.tmp

# Local Netlify folder
.netlify

# graphify: graph.json + wiki verziózva (mentés), a többi újratermelhető
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_analysis.json
graphify-out/20*/
graphify-out.bak*/

# helyi fájltár (feltöltések, PDF-ek) – élesben Netlify Blobs
/data/files

# a sharp Linux-binárisainak oldalsó telepítése (scripts/sharp-linux.mjs)
/.sharp-linux

# helyi adatbázis (a mag a data/seed.json; visszaállítás: npm run db:reset)
/data/site.json

# Google-értékelések állapota: csak place ID + napi hívásszámláló, vélemény SOHA – élesben Netlify Blobs „google”
/data/google
# a régi (szabályba ütköző) vélemény-gyorsítótár maradéka, ha egy régi futásból itt maradt
/data/cache
